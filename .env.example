# Ethereum RPC for ERC-1155 transfer event subscription.
# Free key from https://www.alchemy.com/ (mainnet endpoint).
# If unset, the app falls back to public RPC polling (~30s).
ALCHEMY_API_KEY=

# Optional: override the Normies API base (defaults to https://api.normies.art).
NORMIES_API_BASE=https://api.normies.art

# ---- Ghost presence (Firebase Realtime Database) ----
# Presence is DISABLED until NEXT_PUBLIC_FIREBASE_DATABASE_URL is set — walk
# mode stays safe single-player without it. The rest of the Firebase config is
# a public client config (already shipped in the /tag-battle bundle) and is
# baked as defaults in lib/firebase.ts, so usually you only need the URL below.
#
# Get the URL after enabling Realtime Database in the the-normies-tagbattle
# Firebase console. It looks like one of:
#   https://the-normies-tagbattle-default-rtdb.firebaseio.com               (US)
#   https://the-normies-tagbattle-default-rtdb.europe-west1.firebasedatabase.app (EU)
NEXT_PUBLIC_FIREBASE_DATABASE_URL=

# Optional overrides (defaults baked in lib/firebase.ts):
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
